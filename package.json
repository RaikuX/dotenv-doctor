{
  "name": "@raikux/dotenv-doctor",
  "version": "0.2.0",
  "description": "Zero-dependency CLI that audits .env hygiene: missing vars, placeholder secrets, committed credentials, and type mismatches.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "dotenv-doctor": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node build.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/test.mjs",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit",
    "validate": "node scripts/check-workflows.mjs"
  },
  "keywords": [
    "dotenv",
    "env",
    "environment",
    "secrets",
    "security",
    "lint",
    "ci",
    "audit",
    "cli",
    "developer-tools"
  ],
  "author": "RaikuX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaikuX/dotenv-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/RaikuX/dotenv-doctor/issues"
  },
  "homepage": "https://github.com/RaikuX/dotenv-doctor#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.3.0",
    "typescript": "^7.0.2"
  }
}
